{
  "name": "bleachers",
  "version": "0.1.0",
  "private": true,
  "description": "Bleachers — mobile-first PWA for recording live grassroots sports statistics.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @bleachers/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @bleachers/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @bleachers/api exec prisma generate",
    "db:seed": "pnpm --filter @bleachers/api exec prisma db seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
