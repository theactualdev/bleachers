// Bleachers — event-sourced domain + Better Auth tables share one Postgres database.
// Events are append-only: the only permitted mutation is a correction (voided = true).
// No derived statistic is ever stored here — stats are folded from the Event stream.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Profile — keyed by the Supabase auth.users UUID. A DB trigger creates the row.
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String   @default("")
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Domain back-references (ownership / audit).
  createdPlayers      Player[]        @relation("PlayerCreatedBy")
  createdTeams        Team[]          @relation("TeamCreatedBy")
  createdMatches      Match[]         @relation("MatchCreatedBy")
  recordedEvents      Event[]         @relation("EventRecordedBy")
  voidedEvents        Event[]         @relation("EventVoidedBy")
  memberships         OrgMembership[]
  createdCompetitions Competition[]   @relation("CompetitionCreatedBy")

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain enums
// ─────────────────────────────────────────────────────────────────────────────

enum Sport {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
}

enum StatTier {
  BASIC
  ADVANCED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum MatchSide {
  HOME
  AWAY
}

enum Role {
  OWNER
  SCORER
  VIEWER
}

enum CompetitionFormat {
  KNOCKOUT
  ROUND_ROBIN
  GROUPS
  LADDER
  COLLECTION
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain models
// ─────────────────────────────────────────────────────────────────────────────

model Player {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  dateOfBirth    String? // YYYY-MM-DD
  photo          String?
  createdById    String       @db.Uuid
  createdBy      Profile      @relation("PlayerCreatedBy", fields: [createdById], references: [id])
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rosterEntries RosterEntry[]
  lineups       MatchLineup[]
  events        Event[]

  @@index([createdById])
  @@index([organizationId])
  @@map("player")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  // colors stored as JSON { primary, secondary? }
  colors         Json
  logo           String?
  sport          Sport
  isAdHoc        Boolean      @default(false)
  createdById    String       @db.Uuid
  createdBy      Profile      @relation("TeamCreatedBy", fields: [createdById], references: [id])
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roster      RosterEntry[]
  homeMatches Match[]       @relation("HomeTeam")
  awayMatches Match[]       @relation("AwayTeam")

  @@index([createdById])
  @@index([organizationId])
  @@map("team")
}

model RosterEntry {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  jerseyNumber String?
  createdAt    DateTime @default(now())

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("roster_entry")
}

model Competition {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  sport          Sport
  format         CompetitionFormat
  createdById    String            @db.Uuid
  createdBy      Profile           @relation("CompetitionCreatedBy", fields: [createdById], references: [id])
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  matches Match[]

  @@index([organizationId])
  @@map("competition")
}

model Match {
  id             String       @id @default(uuid()) @db.Uuid
  sport          Sport
  homeTeamId     String       @db.Uuid
  homeTeam       Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId     String       @db.Uuid
  awayTeam       Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venue          String?
  scheduledAt    DateTime
  status         MatchStatus  @default(SCHEDULED)
  statTier       StatTier     @default(BASIC)
  competitionId  String?      @db.Uuid
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  createdById    String       @db.Uuid
  createdBy      Profile      @relation("MatchCreatedBy", fields: [createdById], references: [id])
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lineups MatchLineup[]
  events  Event[]

  @@index([status])
  @@index([competitionId])
  @@index([organizationId])
  @@map("match")
}

model MatchLineup {
  id                   String    @id @default(uuid()) @db.Uuid
  matchId              String    @db.Uuid
  match                Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side                 MatchSide
  playerId             String    @db.Uuid
  player               Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  isStarter            Boolean   @default(true)
  jerseyNumberOverride String?
  createdAt            DateTime  @default(now())

  @@unique([matchId, playerId])
  @@index([matchId])
  @@map("match_lineup")
}

/// The immutable event. Append-only; corrections set `voided`. Nothing is ever deleted.
model Event {
  id              String    @id @db.Uuid // client-generated UUID = idempotency key
  matchId         String    @db.Uuid
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type            String // sport-config event-type id
  side            MatchSide
  playerId        String?   @db.Uuid
  player          Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  period          Int
  clockMs         Int       @default(0)
  metadata        Json      @default("{}")
  voided          Boolean   @default(false)
  voidedById      String?   @db.Uuid
  voidedBy        Profile?  @relation("EventVoidedBy", fields: [voidedById], references: [id])
  voidedAt        DateTime?
  replacesEventId String?   @db.Uuid
  replaces        Event?    @relation("EventReplacement", fields: [replacesEventId], references: [id])
  replacedBy      Event[]   @relation("EventReplacement")
  recordedById    String    @db.Uuid
  recordedBy      Profile   @relation("EventRecordedBy", fields: [recordedById], references: [id])
  recordedAt      DateTime  @default(now())

  @@index([matchId, voided])
  @@index([playerId])
  @@map("event")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations — multi-tenancy. A personal org is auto-created at signup.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /**
   * URL identity for the public page; auto-generated, unique.
   */
  slug        String   @unique
  logo        String?
  isPublic    Boolean  @default(false)
  /**
   * True for the org auto-created at signup; used only for UX defaults.
   */
  isPersonal  Boolean  @default(false)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  OrgMembership[]
  invites      OrgInvite[]
  teams        Team[]
  players      Player[]
  matches      Match[]
  competitions Competition[]

  @@map("organization")
}

model OrgMembership {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_membership")
}

model OrgInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String       @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /**
   * Random URL-safe token (crypto, ≥24 chars); the invite URL is /join/<token>.
   */
  token       String       @unique
  role        Role
  createdById String       @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@map("org_invite")
}
