# --- apps/api/.env ---
DATABASE_URL="postgres://prisma.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgres://prisma.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-or-sb_secret-key>"
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Pre-launch lockdown. Comma-separated; when set, the API rejects every other
# verified session with 403. Leave empty for normal open access.
# See docs/waitlist/README.md — this only works alongside turning off
# "Allow new users to sign up" in Supabase.
ALLOWED_EMAILS=

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
# No Resend key here. This file is committed, and the web app never sends mail.
# The waitlist confirmation is sent by the `waitlist-signup` edge function, so
# the key lives only in Supabase edge-function secrets: