# ─── Database ────────────────────────────────────────────────────────────────
# Used by Prisma (apps/api) and Better Auth (shares the same Postgres instance).
DATABASE_URL="postgresql://bleachers:bleachers@localhost:5432/bleachers?schema=public"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-change-me-please-generate-a-real-secret"
# Base URL the auth server is reachable at (the NestJS API).
BETTER_AUTH_URL="http://localhost:4000"

# Google OAuth (optional in dev; magic links work without it).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (magic links) ─────────────────────────────────────────────────────
# In dev, if these are blank the API logs the magic link to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Bleachers <no-reply@bleachers.app>"

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT="4000"
# Comma-separated list of allowed web origins for CORS.
WEB_ORIGIN="http://localhost:3000"

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
